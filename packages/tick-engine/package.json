{
  "name": "@baseballczar/tick-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Frame-by-frame baseball simulation engine. Pure TypeScript, no runtime deps. Provides GameSession for batch, on-demand, and multiplayer modes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "default": "./dist/entities.js"
    },
    "./formatPbp": {
      "types": "./dist/formatPbp.d.ts",
      "default": "./dist/formatPbp.js"
    },
    "./managerProfiles": {
      "types": "./dist/managerProfiles.d.ts",
      "default": "./dist/managerProfiles.js"
    },
    "./fieldGeometry": {
      "types": "./dist/fieldGeometry.d.ts",
      "default": "./dist/fieldGeometry.js"
    },
    "./gameOrchestrator": {
      "types": "./dist/gameOrchestrator.d.ts",
      "default": "./dist/gameOrchestrator.js"
    },
    "./tickAuthority": {
      "types": "./dist/tickAuthority.d.ts",
      "default": "./dist/tickAuthority.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseballczar/sim-engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
