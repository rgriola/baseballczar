{
  "name": "@baseballczar/sim-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Baseball Czar physics-based simulation engine. Pure TypeScript, no runtime deps.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "sim":        "tsx scripts/sim-lab.ts",
    "sim:season": "tsx scripts/sim-lab.ts --games 162",
    "skill-test": "tsx scripts/skill-test.ts",
    "typecheck":  "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
